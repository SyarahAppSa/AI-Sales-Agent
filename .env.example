# انسخ هذا الملف إلى .env محليًا، وعلى الخادم اضبط القيم كمتغيرات بيئة (لا ترفع الأسرار إلى Git)
DATABASE_URL=postgresql://user:pass@host:5432/mandoob
SECRET_KEY=غيّرها-إلى-قيمة-عشوائية-طويلة
PUBLIC_BASE_URL=https://mandoob.example.com
ADMIN_EMAIL=admin@sayaraup.com
ADMIN_PASSWORD=كلمة-مرور-قوية

# الذكاء الاصطناعي (Claude) — تحليل الطلب، المطابقة، كتابة الرسائل، فهم الردود، البحث على الويب
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low

# مصادر البحث
GOOGLE_PLACES_API_KEY=
BRAVE_SEARCH_API_KEY=

# Microsoft 365 (Entra ID app — صلاحيات تطبيق: Mail.Send, Mail.ReadWrite, Calendars.ReadWrite)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# أو Google Workspace (OAuth لحساب المرسل — gmail.send, gmail.readonly, calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# المساعد الصوتي (اختياري)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
VOICE_WEBHOOK_SECRET=
